{
  "name": "eventsnare",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "setup": "pnpm install && pnpm --filter @eventsnare/convex run codegen",
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --parallel --filter=eventsnare-web --filter=@eventsnare/convex",
    "dev:admin": "turbo run dev --parallel --filter=eventsnare-admin --filter=@eventsnare/convex",
    "dev:landing": "turbo run dev --parallel --filter=eventsnare-landing",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.60.0"
  }
}
