# eventsnare — generated by Scaffold Studio

# ---------- Convex ----------

# Convex deployment URL exposed to the browser (e.g., https://<dep>.convex.cloud). Required by all Vite apps.
VITE_CONVEX_URL=

# Convex deployment identifier used by the Convex CLI. Set automatically by `convex dev` linking; copy from packages/convex/.env.local once linked.
CONVEX_DEPLOYMENT=

# ---------- Clerk ----------

# Clerk publishable key for the web app (find it in the Clerk dashboard under API Keys).
VITE_CLERK_PUBLISHABLE_KEY=

# Clerk publishable key for the Expo mobile app (same value as VITE_CLERK_PUBLISHABLE_KEY).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Clerk secret key used by Convex backend functions to verify identities.
CLERK_SECRET_KEY=

# Clerk JWT issuer domain used by Convex auth.config.ts (e.g., https://your-app.clerk.accounts.dev).
CLERK_JWT_ISSUER_DOMAIN=

# Signing secret for the Clerk webhook that syncs users into Convex (Clerk dashboard → Webhooks).
CLERK_WEBHOOK_SECRET=

# VAPID public key for web push (browser-side). Generate a keypair with `npx web-push generate-vapid-keys` and paste the public key here.
VITE_VAPID_PUBLIC_KEY=

# VAPID public key for the Convex backend. Same value as VITE_VAPID_PUBLIC_KEY. Set it in the deployment with `npx convex env set VAPID_PUBLIC_KEY <key>`.
VAPID_PUBLIC_KEY=

# VAPID private key for the Convex backend. From `npx web-push generate-vapid-keys`. Set it with `npx convex env set VAPID_PRIVATE_KEY <key>` (never commit it).
VAPID_PRIVATE_KEY=

# VAPID subject for the Convex backend: a mailto: address or URL, e.g. mailto:you@example.com. Set it with `npx convex env set VAPID_SUBJECT mailto:you@example.com`.
VAPID_SUBJECT=

# Stripe secret key (test mode: starts with sk_test_). Used by Convex actions and webhook verification.
STRIPE_SECRET_KEY=

# Signing secret for the /stripe-webhook endpoint (from Stripe dashboard → Developers → Webhooks).
STRIPE_WEBHOOK_SECRET=

# Stripe publishable key. Currently unused server-side; reserved for client-side Stripe.js if added later.
STRIPE_PUBLISHABLE_KEY=

# Web mirror of STRIPE_PUBLISHABLE_KEY exposed to the browser via Vite.
VITE_STRIPE_PUBLISHABLE_KEY=

# Example Stripe Price ID for the Pro plan. Replace with your real price ID and seed the plans table.
STRIPE_PRICE_ID_PRO=

# Example Stripe Price ID for the Team plan. Replace with your real price ID and seed the plans table.
STRIPE_PRICE_ID_TEAM=
